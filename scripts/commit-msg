#!/bin/sh
# quimera:commit-msg — discreet mode guard.
# Removes AI co-author trailers and "generated with" lines from commit messages,
# whatever tool wrote them. Installed into the git hooks folder (local only, never committed).
# If anything goes wrong, the message is left as it was and the commit stops with an error.
msg_file="$1"
[ -f "$msg_file" ] || exit 0
fail() {
  echo "quimera commit-msg guard: $1; the message was left unchanged" >&2
  exit 1
}
# A private folder of its own, so no other user can plant a file name the guard writes to.
dir=$(mktemp -d "${TMPDIR:-/tmp}/quimera-msg.XXXXXX") || fail "cannot create a temporary folder"
trap 'rm -rf "$dir"' EXIT
tmp="$dir/filtered"
grep -v -i -E \
  -e '^co-authored-by:.*(claude|anthropic|openai|codex|copilot|chatgpt|gpt|gemini|cursor|deepseek|mimo)' \
  -e '^(🤖 )?generated (with|by) .*(claude|codex|copilot|chatgpt|gpt|gemini|cursor|(^|[^a-z])ai([^a-z]|$))' \
  -e '^claude-session:' \
  "$msg_file" > "$tmp"
# grep exits 1 when it removed every line; 2 or more is an error.
[ $? -le 1 ] || fail "could not filter the message"
# Drop trailing blank lines left behind, keeping each line's own ending (LF or CRLF).
awk '{ line = $0; sub(/\r$/, "", line) } line ~ /[^ \t]/ { for (i = 0; i < blank; i++) print held[i]; blank = 0; print; next } { held[blank++] = $0 }' \
  "$tmp" > "$dir/tidy" || fail "could not tidy the message"
cat "$dir/tidy" > "$msg_file" || fail "could not write the message"
exit 0
